
import os
import csv
import json


# Абсолютные пути для работы пайплайна
hw_dir = os.path.abspath(".")
test_input_dir = os.path.abspath("./test_input")

# Читаем параметры из params.json
with open("params.json", "r") as f:
    params = json.load(f)

# Абсолютный путь к директории вывода из params.json
test_output_dir = os.path.abspath(params["global_params"]["outdir"])

# Создаем словарь для хранения информации о каждом уникальном sample_id
samples = {}
unique_sample_ids = set()

# Первый проход - собираем все уникальные sample_id и их read файлы
with open(os.path.join(hw_dir, "samples.csv"), "r") as csvfile:
    reader = csv.DictReader(csvfile)
    for row in reader:
        base_sample_id = row["sample_id"].replace("_assembly", "")
        unique_sample_ids.add(base_sample_id)
        
        # Если это первая встреча sample_id или его версии с _assembly
        if base_sample_id not in samples:
            samples[base_sample_id] = {
                "read_1": os.path.abspath(row.get("read_1", "")),
                "read_2": os.path.abspath(row.get("read_2", "")),
                "assembly": ""
            }
        
        # Если есть assembly, добавляем его (даже если это в строке с _assembly)
        if row.get("assembly"):
            samples[base_sample_id]["assembly"] = os.path.abspath(row["assembly"])

# Создаем списки образцов с assembly и без него
samples_with_assembly = []
samples_without_assembly = []

# Распределяем образцы по спискам
for sample_id in unique_sample_ids:
    if samples[sample_id]["assembly"]:
        samples_with_assembly.append(sample_id)
    else:
        samples_without_assembly.append(sample_id)

def get_final_output():
    final_outputs = []
    
    # Для образцов с assembly
    for sample in samples_with_assembly:
        final_outputs.extend([
            f"{test_output_dir}/{sample}_assembly_quast/report.html",  # Обратите внимание на _assembly
            f"{test_output_dir}/{sample}_assembly_prokka/annotation.txt",
            f"{test_output_dir}/{sample}_assembly_abricate/ncbi_results.txt",
            f"{test_output_dir}/{sample}_assembly_abricate/resfi_results.txt"
        ])
    
    # Для образцов без assembly
    for sample in samples_without_assembly:
        final_outputs.extend([
            f"{test_output_dir}/{sample}_fastqc/{sample}_1_fastqc.html",
            f"{test_output_dir}/{sample}_fastqc/{sample}_2_fastqc.html",
            f"{test_output_dir}/{sample}_spades/scaffolds.fasta",
            f"{test_output_dir}/{sample}_quast/report.html",
            f"{test_output_dir}/{sample}_prokka/annotation.txt",
            f"{test_output_dir}/{sample}_abricate/ncbi_results.txt",
            f"{test_output_dir}/{sample}_abricate/resfi_results.txt"
        ])
    
    return final_outputs

rule all:
    input:
        # # Для обычных образцов
        # expand(f"{test_output_dir}/{{sample}}_abricate/ncbi_results.txt", 
        #        sample=samples_without_assembly),
        # expand(f"{test_output_dir}/{{sample}}_abricate/resfi_results.txt", 
        #        sample=samples_without_assembly),
        # # Для образцов с assembly добавляем суффикс _assembly
        # expand(f"{test_output_dir}/{{sample}}_assembly_abricate/ncbi_results.txt", 
        #        sample=samples_with_assembly),
        # expand(f"{test_output_dir}/{{sample}}_assembly_abricate/resfi_results.txt", 
        #        sample=samples_with_assembly)
        get_final_output()

# Правило fastqc запускается только для образцов без assembly
rule fastqc_raw:
    input:
        read1=lambda wildcards: samples[wildcards.sample]["read_1"],
        read2=lambda wildcards: samples[wildcards.sample]["read_2"]
    conda: "./envs/fastqc.yaml"
    threads: params["fastqc"]["threads"]
    output:
        fastqc_html_1=f"{test_output_dir}/{{sample}}_fastqc/{{sample}}_1_fastqc.html",
        fastqc_html_2=f"{test_output_dir}/{{sample}}_fastqc/{{sample}}_2_fastqc.html"
    params:
        outdir=f"{test_output_dir}/{{sample}}_fastqc"
    shell:
        "fastqc {input.read1} {input.read2} -o {params.outdir} -t {threads}"


# Правило spades запускается только для образцов без assembly
rule spades:
    input:
        read1=lambda wildcards: samples[wildcards.sample]["read_1"],
        read2=lambda wildcards: samples[wildcards.sample]["read_2"]
    conda: "./envs/spades.yaml"
    threads: params["spades"]["threads"]
    output:
        scaffolds=f"{test_output_dir}/{{sample}}_spades/scaffolds.fasta"
    params:
        outdir=f"{test_output_dir}/{{sample}}_spades"
    shell:
        "spades.py -1 {input.read1} -2 {input.read2} -o {params.outdir}"

# Правило quast запускается для всех образцов, но использует разные входные данные
rule quast:
    input:
        scaffolds=lambda wildcards: (
            samples[wildcards.sample.replace("_assembly", "")]["assembly"]
            if "_assembly" in wildcards.sample
            else f"{test_output_dir}/{wildcards.sample}_spades/scaffolds.fasta"
        )
    conda: "./envs/quast.yaml"
    output:
        report=f"{test_output_dir}/{{sample}}_quast/report.html"
    params:
        outdir=f"{test_output_dir}/{{sample}}_quast"
    shell:
        "quast.py {input.scaffolds} -o {params.outdir}"

# Правило prokka использует ту же логику, что и quast
rule prokka:
    input:
        scaffolds=lambda wildcards: (
            samples[wildcards.sample.replace("_assembly", "")]["assembly"]
            if "_assembly" in wildcards.sample
            else f"{test_output_dir}/{wildcards.sample}_spades/scaffolds.fasta"
        )
    conda: "./envs/prokka.yaml"
    output:
        annotated_dir=directory(f"{test_output_dir}/{{sample}}_prokka"),
        annotation=f"{test_output_dir}/{{sample}}_prokka/annotation.txt"
    params:
        prefix=params["prokka"]["prefix"]
    shell:
        'prokka --outdir {output.annotated_dir} --force --prefix {params.prefix} {input.scaffolds}'

# Правило abricate также использует ту же логику для входных данных
rule abricate:
    input:
        scaffolds=lambda wildcards: (
            samples[wildcards.sample.replace("_assembly", "")]["assembly"]
            if "_assembly" in wildcards.sample
            else f"{test_output_dir}/{wildcards.sample}_spades/scaffolds.fasta"
        )
    conda: "./envs/abricate.yaml"
    output:
        ncbi_results=f"{test_output_dir}/{{sample}}_abricate/ncbi_results.txt",
        resfinder_results=f"{test_output_dir}/{{sample}}_abricate/resfi_results.txt"
    params:
        outdir=f"{test_output_dir}/{{sample}}_abricate"
    shell:
        """
        abricate --db ncbi {input.scaffolds} > {output.ncbi_results} && \
        abricate --db resfinder {input.scaffolds} > {output.resfinder_results}
        """